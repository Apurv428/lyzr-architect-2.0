# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Public URL of this app (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Claude (optional — without a key the builder runs in scripted demo mode)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# OpenAI (alternative to Claude — used when no Anthropic key is set, or when AI_PROVIDER=openai)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# AI_PROVIDER=openai

# Any OpenAI-compatible provider can stand in for OpenAI. Gemini's free tier (key from aistudio.google.com):
# OPENAI_API_KEY=<gemini key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-flash-latest
# OPENAI_EMBED_MODEL=gemini-embedding-001

# Encrypts stored secrets (GitHub token cookie, env var values). 32+ random characters, e.g. `openssl rand -base64 48`
ARCHITECT_SECRET=

# ── GitHub OAuth (for "Connect GitHub" in Import, Publish dialog, and Settings) ──────────────────
# The app does NOT hold a GitHub Client ID/Secret — Supabase handles the OAuth exchange.
# Steps to enable:
#   1. Create a GitHub OAuth App at https://github.com/settings/developers → "New OAuth App"
#      - Homepage URL: your app's URL (e.g. http://localhost:3000)
#      - Authorization callback URL: https://<your-supabase-project-ref>.supabase.co/auth/v1/callback
#   2. In the Supabase Dashboard → Authentication → Providers → GitHub
#      - Toggle "Enable GitHub provider" ON
#      - Paste the Client ID and Client Secret from your GitHub OAuth App
#      - Save
# Once configured, the "Connect GitHub" button (OAuth flow) and the PAT fallback both work.
# Without this setup, only the personal access token (PAT) path functions.

# ── Agent model choices beyond Claude and GPT (Agent tab → Brain → Model) ───────────────────────
# Gemini runs on GEMINI_API_KEY, or on the platform key above when OPENAI_BASE_URL already points at Gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# Llama (open-source) runs on any OpenAI-compatible host: Groq, Together, OpenRouter, or a local Ollama.
# LLAMA_BASE_URL=https://api.groq.com/openai/v1
# LLAMA_API_KEY=
# LLAMA_MODEL=llama-3.3-70b-versatile

# ── Scheduled agents (trigger "Schedule") ──────────────────────────────────────────────────────
# After running supabase/migrations/0017_schedules.sql, copy the generated secret:
#   select secret from private.scheduler_secret;
# then have a cron call GET /api/cron/schedules every minute with "Authorization: Bearer <CRON_SECRET>"
# (Supabase pg_cron + pg_net, cron-job.org, or Vercel Cron). See docs/ARCHITECTURE.md §10.
# CRON_SECRET=

# E2B cloud sandboxes (optional — only needed for the E2B preview runtime)
E2B_API_KEY=

# Demo seeding only (`npm run seed`) — never expose the service role key to the browser
# SUPABASE_SERVICE_ROLE_KEY=
# DEMO_USER_EMAIL=demo@example.com

# Signed-in Playwright tests (`npm run test:e2e`) — a test account on your Supabase project
# E2E_EMAIL=
# E2E_PASSWORD=
# Dev-only test login route (app/api/test/session) — disabled unless set; never set it in production
# E2E_SECRET=
